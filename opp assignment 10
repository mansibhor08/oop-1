#include<iostream>
using namespace std;

template <class T>
T larger(T a,T b)
{
 if(a>b)
   return a;
 else
   return b;
}

int main()
{
 cout<<"Greater Student Mark: "<< larger(85,90)<<endl;
 cout<<"Greater Product Price: "<< larger(250.50,300.75)<<endl;
 cout<<"Greater Sensor Reading: "<< larger(85,90)<<endl;
 return 0;
}
