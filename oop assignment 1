#include<iostream>
using namespace std;
class book
{
public:
string title;
int book_id;
float prize;

void display()
{
cout<<"\n---BOOK DETAILS---"<<endl;
cout<<"Title of the book: "<<title<<endl;
cout<<"Book ID: "<<book_id<<endl;
cout<<"Prize of the book: "<<prize<<endl;
}
};
int main()
{
book b1;
cout<<"Enter the title: "<<endl;
cin>>b1.title;
cout<<"Enter the book id: "<<endl;
cin>>b1.book_id;
cout<<"Enter prize of the book: "<<endl;
cin>>b1.prize;
b1.display();
return 0;
}
