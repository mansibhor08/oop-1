#include<iostream>
using namespace std;

class Employee
{
int empID;
string name;
float salary;
public:

Employee(int id,string n,float s)
{
empID = id;
name = n;
salary = s;

cout<<"Employee record created"<<endl;
}

~Employee()
{
cout<<"Employee record remove from memory."<<endl;
}

void display()
{
cout<<"Id of the employee is: "<<empID<<endl;
cout<<"Name of the employee is: "<<name<<endl;
cout<<"Salary of the employee is: "<<salary<<endl;
}
};
int main()
{
Employee e1(101,"xyz",45000);
e1.display();
return 0;
}

